  <rdf:Description rdf:about="http://purl.org/spar/mito/isMentioningEntityOf">
    <rdfs:comment xml:lang="en">The relation between a mentioning entity and a mention.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vann:example>
    :my-mentioning-entity 
        mito:isMentioningEntityOf :my-mention .

    :my-mention a mito:Mention .
    </vann:example>
    <rdfs:label xml:lang="en">is mentioning entity of</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/mito"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <owl:inverseOf rdf:resource="http://purl.org/spar/mito/hasMentioningEntity"/>
  </rdf:Description>
</rdf:RDF>
