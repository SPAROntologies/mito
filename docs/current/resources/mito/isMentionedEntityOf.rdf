<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/mito/isMentionedEntityOf">
    <rdfs:comment xml:lang="en">The relation between a mentioned entity and a mention.</rdfs:comment>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label xml:lang="en">is mentioned entity of</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/mito"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://purl.org/spar/mito/hasMentionedEntity"/>
    <vann:example>
    :my-mentioned-entity 
        mito:isMentionedEntityOf :my-mention .

    :my-mention a mito:Mention .
    </vann:example>
  </rdf:Description>
</rdf:RDF>
