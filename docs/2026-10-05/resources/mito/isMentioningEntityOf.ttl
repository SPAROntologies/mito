@prefix mito: <http://purl.org/spar/mito/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

mito:isMentioningEntityOf a owl:ObjectProperty ;
    rdfs:label "is mentioning entity of"@en ;
    vann:example """
    :my-mentioning-entity 
        mito:isMentioningEntityOf :my-mention .

    :my-mention a mito:Mention .
    """ ;
    rdfs:comment "The relation between a mentioning entity and a mention."@en ;
    rdfs:isDefinedBy <http://purl.org/spar/mito> ;
    owl:inverseOf mito:hasMentioningEntity ;
    vs:term_status reg:statusStable .

