  {
    "@id": "http://purl.org/spar/mito/implicit",
    "@type": [
      "http://purl.org/spar/mito/MentionType",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-mention a mito:Mention ;\n        mito:hasMentioningEntity :my-mentioning-entity ;\n        mito:hasMentionedEntity :my-mentioned-entity ;\n        mito:hasMentionType mito:implicit .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\nA type of mention according to which something is suggested or understood through context rather than named directly within a text.\n    "
      }
